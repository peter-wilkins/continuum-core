{
  "name": "@continuum/core",
  "version": "0.0.0",
  "description": "Shared inference, memory, retrieval, and context-resume engine for TypeScript host apps.",
  "type": "module",
  "private": true,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "bin": {
    "continuum-import": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "CONTEXT.md",
    "docs"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --sourcemap && tsup src/cli.ts --format esm --dts --sourcemap",
    "schema:dev": "vite --config schema-workbench/vite.config.ts schema-workbench --host 127.0.0.1 --port 5173",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.4",
    "vitest": "^4.1.7"
  },
  "dependencies": {
    "zod": "^4.4.3"
  }
}
